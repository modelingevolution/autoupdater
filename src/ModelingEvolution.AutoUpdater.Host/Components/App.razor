@inject ModelingEvolution.AutoUpdater.Apps.AppsSettings Apps

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    @* The markdown renderer is only for the Apps page's guides: disabled, its ~1 MB of script is not sent at all. *@
    @if (Apps.Enabled)
    {
        <link href="_content/MudBlazor.Markdown/MudBlazor.Markdown.min.css" rel="stylesheet" />
    }

    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ModelingEvolution.AutoUpdater.Host.styles.css" />
    <FaviconLink />
    <HeadOutlet  />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    @if (Apps.Enabled)
    {
        <script src="_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"></script>
    }
    <script src="j.js"></script>
</body>

</html>
