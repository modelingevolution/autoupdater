@page "/apps"
@using ModelingEvolution.AutoUpdater.Apps
@inject AppsSettings Settings

@* Disabled, a request for /apps never gets here (UseAppsGate answers 404). This covers navigation inside a running circuit. *@
@if (Settings.Options is { } options)
{
    <AppsView Options="options" />
}
else
{
    <PageTitle>Not found</PageTitle>
    <MudText Typo="Typo.h5" data-testid="apps-disabled">Not found</MudText>
}
