@page "/apps"
@using System.Collections.ObjectModel
@using System.ComponentModel
@using ModelingEvolution.AutoUpdater.Apps
@using ModelingEvolution.AutoUpdater.Services
@using ModelingEvolution.AutoUpdater.Host.Models
@implements IAsyncDisposable
@inject AppsCatalogClient CatalogClient
@inject PackageStateReadModel ReadModel
@inject IProgressService Progress
@inject ILogger<Apps> Logger

<PageTitle>Apps</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Apps</MudText>

@if (_package == null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="apps-not-configured">
        The apps package is not set up on this station. The installers below become available once it is.
    </MudAlert>
}
else
{
    <Observable Source="_package">
        @if (context.IsUpdateInProgress)
        {
            <MudPaper Class="pa-4 mb-4" data-testid="apps-progress">
                <MudText Typo="Typo.body1" Class="mb-2">Downloading the apps to this station</MudText>
                <MudText Typo="Typo.caption" data-testid="apps-progress-operation">@ProgressCaption</MudText>
                <MudProgressLinear Value="@(ProgressValue ?? 0)" Indeterminate="@(ProgressValue == null)" Color="Color.Primary" Class="mt-2" />
            </MudPaper>
        }
        else if (!context.IsPackageValid)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="apps-package-error">
                <MudText Typo="Typo.body2">The last download or version check failed. @AppsFailureText.Describe(context.OperationMessage)</MudText>
                <MudText Typo="Typo.body2">To retry, open <MudLink Href="/">Packages</MudLink>, check the version of this package, then update it.</MudText>
            </MudAlert>
        }
        else if (context.IsUpgradeAvailable && context.AvailableVersion != null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="apps-update-available">
                @if (context.CurrentVersion == null)
                {
                    <MudText Typo="Typo.body2">Release @context.AvailableVersion is available but not on this station yet. Start the download from <MudLink Href="/">Packages</MudLink>.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">A newer release, @context.AvailableVersion, is available (this station has @context.CurrentVersion). Start the download from <MudLink Href="/">Packages</MudLink>.</MudText>
                }
            </MudAlert>
        }
    </Observable>
}

<MudStack Spacing="4">
    <ObservableForEach ItemSource="@_rows" IsNotifyPropertyChangedEnabled="true" Context="row">
        <MudPaper Class="pa-4" Elevation="2" data-testid="@($"app-{row.Guide.Platform}")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5">@row.Guide.DisplayName</MudText>
                    @if (row.Guide.Preview)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" data-testid="app-preview">Preview</MudChip>
                    }
                </MudStack>
                <MudChip T="string" Color="@StatusColor(row.Status)" data-testid="app-status">@StatusText(row.Status)</MudChip>
            </MudStack>

            <MudText Typo="Typo.body2" Class="mt-1">@row.Guide.Requirements</MudText>

            @if (row.Guide.Warning != null)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="app-warning">@row.Guide.Warning</MudAlert>
            }

            @if (row.File != null)
            {
                <MudGrid Spacing="2" Class="mt-2">
                    <MudItem xs="6" sm="3"><MudField Label="Version" Variant="Variant.Text" data-testid="app-version">@row.File.Version</MudField></MudItem>
                    <MudItem xs="6" sm="3"><MudField Label="Size" Variant="Variant.Text" data-testid="app-size">@(new Bytes(row.File.Size).ToString())</MudField></MudItem>
                    <MudItem xs="12" sm="6"><MudField Label="File" Variant="Variant.Text" Style="word-break: break-all;">@row.File.FileName</MudField></MudItem>
                    <MudItem xs="12"><MudField Label="SHA-256" Variant="Variant.Text" Style="word-break: break-all;" data-testid="app-sha256">@row.File.Sha256</MudField></MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption">Check it after downloading: @row.Guide.VerifyHashCommand</MudText>
            }

            @if (row.CanDownload)
            {
                <MudStack Row="true" Class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Download"
                               Href="@AppsOptions.DownloadPath(row.File!.FileName)"
                               data-testid="app-download">Download</MudButton>
                </MudStack>
            }

            @if (row.Guide.Note != null)
            {
                <MudText Typo="Typo.body2" Class="mt-3">@row.Guide.Note</MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-3">Install</MudText>
            <MudStack Spacing="1" Class="mt-1">
                @* Each step carries its own number: a counter would be captured by the child-content lambdas and show its last value. *@
                @foreach (var (step, number) in row.Guide.Steps.Select((s, i) => (s, i + 1)))
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline" data-testid="app-step">
                        <MudText Typo="Typo.body2">@(number).</MudText>
                        <MudText Typo="Typo.body2">@step.Text</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    </ObservableForEach>
</MudStack>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private readonly ObservableCollection<AppRow> _rows = new(AppGuides.All.Select(g => new AppRow(g)));
    private readonly CancellationTokenSource _stop = new();
    private PackageState? _package;
    private AppsCatalog? _catalog;
    private Task? _refreshLoop;

    private bool ProgressIsOurs => Progress.IsRunning && _package != null && Progress.CurrentApplication == _package.PackageName.ToString();
    // The AutoUpdater's own fixed operation and pull-progress captions (UpdateHost.FormatPullPhase), never error text.
    private string ProgressCaption => ProgressIsOurs ? Progress.PhaseMessage ?? Progress.CurrentOperation : "Starting";
    private double? ProgressValue => ProgressIsOurs ? Progress.PhaseProgress ?? Progress.ProgressPercentage : null;

    protected override void OnInitialized()
    {
        AttachPackage();
        Progress.Changed += OnProgressChanged;
        ApplyToRows();
    }

    /// <summary>Finds the package, also later: one registered while the page is open shows up on the next refresh.</summary>
    private bool AttachPackage()
    {
        if (_package != null) return false;
        _package = ReadModel.GetPackageState(new PackageName(CatalogClient.Options.PackageName));
        if (_package == null) return false;
        _package.PropertyChanged += OnPackageChanged;
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Not during prerender, and not awaited: the page shows at once however long the container takes to answer.
        if (firstRender) _refreshLoop = RefreshLoopAsync(_stop.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken stop)
    {
        try
        {
            using var timer = new PeriodicTimer(RefreshInterval);
            do
            {
                var catalog = await CatalogClient.GetAsync(stop);
                await InvokeAsync(() =>
                {
                    _catalog = catalog;
                    if (AttachPackage()) StateHasChanged();
                    ApplyToRows();
                });
            } while (await timer.WaitForNextTickAsync(stop));
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            // Never fault the loop silently, and never let DisposeAsync rethrow: the page just stops refreshing.
            Logger.LogWarning(ex, "The Apps page stopped refreshing the apps catalog");
        }
    }

    private void ApplyToRows()
    {
        var snapshot = new AppsPackageSnapshot(_package?.CurrentVersion != null, _package?.IsUpdateInProgress ?? false);
        foreach (var row in _rows) row.Apply(_catalog, snapshot);
    }

    private void OnPackageChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(ApplyToRows);
    }

    private void OnProgressChanged()
    {
        if (ProgressIsOurs) _ = InvokeAsync(StateHasChanged);
    }

    private static string StatusText(AppStatus status) => status switch
    {
        AppStatus.Checking => "Checking",
        AppStatus.NotDownloaded => "Not downloaded",
        AppStatus.Downloading => "Downloading",
        AppStatus.ServiceUnavailable => "Unavailable",
        AppStatus.NotAvailableYet => "Not available yet",
        AppStatus.ChecksumFailed => "Checksum failed",
        AppStatus.NotVerified => "Not verified",
        AppStatus.Ready => "Ready, checksum verified",
        _ => status.ToString(),
    };

    private static Color StatusColor(AppStatus status) => status switch
    {
        AppStatus.Ready => Color.Success,
        AppStatus.Downloading => Color.Info,
        AppStatus.ChecksumFailed or AppStatus.ServiceUnavailable => Color.Error,
        AppStatus.NotVerified => Color.Warning,
        _ => Color.Default,
    };

    public async ValueTask DisposeAsync()
    {
        if (_package != null) _package.PropertyChanged -= OnPackageChanged;
        Progress.Changed -= OnProgressChanged;

        await _stop.CancelAsync();
        if (_refreshLoop != null) await _refreshLoop;
        _stop.Dispose();
    }
}
