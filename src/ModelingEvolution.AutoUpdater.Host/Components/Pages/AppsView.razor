@using System.Collections.ObjectModel
@using System.ComponentModel
@using ModelingEvolution.AutoUpdater.Apps
@using ModelingEvolution.AutoUpdater.Services
@using ModelingEvolution.AutoUpdater.Host.Models
@implements IAsyncDisposable
@inject AppsCatalogClient CatalogClient
@inject PackageStateReadModel ReadModel
@inject IProgressService Progress
@inject ILogger<AppsView> Logger

@* Renders whatever the apps image's manifest.json lists, read once when the page opens: one card per app, one section
   per download. Names and labels are plain text (Blazor encodes them); guides are markdown, rendered by AppGuideView;
   icons are PNGs served through /apps/icons. *@

<PageTitle>@Options.Title</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Options.Title</MudText>

@if (Options.PackageName != null && _package == null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="apps-not-configured">
        The apps package is not set up on this station.
    </MudAlert>
}
else if (_package != null)
{
    <Observable Source="_package">
        @if (context.IsUpdateInProgress)
        {
            <MudPaper Class="pa-4 mb-4" data-testid="apps-progress">
                <MudText Typo="Typo.body1" Class="mb-2">Downloading the apps to this station</MudText>
                <MudText Typo="Typo.caption" data-testid="apps-progress-operation">@ProgressCaption</MudText>
                <MudProgressLinear Value="@(ProgressValue ?? 0)" Indeterminate="@(ProgressValue == null)" Color="Color.Primary" Class="mt-2" />
            </MudPaper>
        }
        else if (!context.IsPackageValid)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="apps-package-error">
                <MudText Typo="Typo.body2">The last download or version check failed. @AppsFailureText.Describe(context.OperationMessage)</MudText>
                <MudText Typo="Typo.body2">To retry, open <MudLink Href="/">Packages</MudLink>, check the version of this package, then update it.</MudText>
            </MudAlert>
        }
        else if (context.IsUpgradeAvailable && context.AvailableVersion != null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="apps-update-available">
                @if (context.CurrentVersion == null)
                {
                    <MudText Typo="Typo.body2">Release @context.AvailableVersion is available but not on this station yet. Start the download from <MudLink Href="/">Packages</MudLink>.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">A newer release, @context.AvailableVersion, is available (this station has @context.CurrentVersion). Start the download from <MudLink Href="/">Packages</MudLink>.</MudText>
                }
            </MudAlert>
        }
    </Observable>
}

@switch (_pageStatus)
{
    case AppsPageStatus.Checking:
        <MudText Typo="Typo.body1" data-testid="apps-checking">Checking which apps are available…</MudText>
        break;
    case AppsPageStatus.NotDownloaded:
        <MudAlert Severity="Severity.Info" data-testid="apps-not-downloaded">The apps are not on this station yet. Start the download from <MudLink Href="/">Packages</MudLink>.</MudAlert>
        break;
    case AppsPageStatus.Unavailable:
        <MudAlert Severity="Severity.Error" data-testid="apps-unavailable">The apps service is not answering, so no app can be offered right now. Reload the page to try again.</MudAlert>
        break;
    case AppsPageStatus.UnsupportedSchema:
        <MudAlert Severity="Severity.Error" data-testid="apps-unsupported">The apps on this station are described in a format this AutoUpdater does not read (manifest schema @_catalog?.UnsupportedSchemaVersion, expected @AppsManifest.SchemaVersion). Publish them again with the current publish-apps.sh, or update the AutoUpdater.</MudAlert>
        break;
    case AppsPageStatus.Empty:
        <MudAlert Severity="Severity.Info" data-testid="apps-empty">No apps are published.</MudAlert>
        break;
}

<MudStack Spacing="4">
    <ObservableForEach ItemSource="@_cards" IsNotifyPropertyChangedEnabled="true" Context="card">
        <MudPaper Class="pa-4" Elevation="2" data-testid="@($"app-{card.Id}")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" data-icon-state="@card.Icon">
                @if (card.Icon == LoadState.Loaded)
                {
                    <img src="@AppIcon.Path(card.Entry.Icon!)" alt="" width="48" height="48" style="object-fit: contain;" data-testid="app-icon" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Apps" Style="font-size: 48px;" data-testid="app-icon-default" />
                }
                <MudText Typo="Typo.h5" data-testid="app-name">@card.Entry.Name</MudText>
            </MudStack>

            @if (card.Downloads.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-3" data-testid="app-no-downloads">Not available yet.</MudText>
            }

            <ObservableForEach ItemSource="@card.Downloads" IsNotifyPropertyChangedEnabled="true" Context="row">
                <MudDivider Class="my-3" />
                <div data-testid="@($"download-{row.Download.Key}")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@PlatformIcon(row.Download.Platform)" data-testid="download-platform-icon" />
                            <MudText Typo="Typo.h6" data-testid="download-title">@DownloadTitle(row.Download)</MudText>
                            @if (row.Download.Preview)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-testid="download-preview">Preview</MudChip>
                            }
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(row.Status)" data-testid="download-status">@StatusText(row.Status)</MudChip>
                    </MudStack>

                    @if (row.File != null)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="4" Class="mt-2">
                            <MudText Typo="Typo.body2" data-testid="download-version">Version @row.File.Version</MudText>
                            <MudText Typo="Typo.body2" data-testid="download-size">@(new Bytes(row.File.Size).ToString())</MudText>
                            <MudText Typo="Typo.body2" Style="word-break: break-all;" data-testid="download-file">@row.File.FileName</MudText>
                            @if (row.CanDownload)
                            {
                                <MudSpacer />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           Href="@AppsOptions.DownloadPath(row.File.FileName)"
                                           data-testid="download-button">Download</MudButton>
                            }
                        </MudStack>
                    }

                    @switch (row.Guide)
                    {
                        case LoadState.Loading:
                            <MudProgressLinear Indeterminate="true" Class="mt-3" data-testid="download-guide-loading" />
                            break;
                        case LoadState.Loaded:
                            @* A guide that still fails to render takes down only itself, never the page. *@
                            <ErrorBoundary>
                                <ChildContent>
                                    <div class="mt-3" data-testid="download-guide">
                                        <AppGuideView Markdown="@row.GuideMarkdown" />
                                    </div>
                                </ChildContent>
                                <ErrorContent>
                                    <MudText Typo="Typo.body2" Class="mt-3" data-testid="download-guide-unavailable">Install guide unavailable.</MudText>
                                </ErrorContent>
                            </ErrorBoundary>
                            break;
                        case LoadState.Unavailable:
                            <MudText Typo="Typo.body2" Class="mt-3" data-testid="download-guide-unavailable">Install guide unavailable.</MudText>
                            break;
                    }
                </div>
            </ObservableForEach>
        </MudPaper>
    </ObservableForEach>
</MudStack>

@code {
    [Parameter, EditorRequired] public AppsOptions Options { get; set; } = null!;

    private readonly ObservableCollection<AppCard> _cards = new();
    private readonly CancellationTokenSource _stop = new();
    private PackageState? _package;
    private AppsCatalog? _catalog;
    private AppsPageStatus _pageStatus = AppsPageStatus.Checking;
    private Task? _load;

    private bool ProgressIsOurs => Progress.IsRunning && _package != null && Progress.CurrentApplication == _package.PackageName.ToString();
    // The AutoUpdater's own fixed operation and pull-progress captions (UpdateHost.FormatPullPhase), never error text.
    private string ProgressCaption => ProgressIsOurs ? Progress.PhaseMessage ?? Progress.CurrentOperation : "Starting";
    private double? ProgressValue => ProgressIsOurs ? Progress.PhaseProgress ?? Progress.ProgressPercentage : null;

    protected override void OnInitialized()
    {
        if (Options.PackageName != null)
        {
            _package = ReadModel.GetPackageState(new PackageName(Options.PackageName));
            if (_package != null) _package.PropertyChanged += OnPackageChanged;
        }

        Progress.Changed += OnProgressChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Not during prerender, and not awaited: the page shows at once however long the image takes to answer.
        if (firstRender) _load = LoadAsync(_stop.Token);
    }

    /// <summary>One read of manifest.json, then each listed icon and guide. Nothing polls: reloading the page reads again.</summary>
    private async Task LoadAsync(CancellationToken stop)
    {
        try
        {
            var catalog = await CatalogClient.GetAsync(stop);
            var cards = AppCard.For(catalog, Snapshot());
            await InvokeAsync(() =>
            {
                _catalog = catalog;
                _pageStatus = AppCard.DecidePage(catalog, Snapshot());
                foreach (var card in cards) _cards.Add(card);
                StateHasChanged();
            });

            var icons = cards.Where(c => c.Entry.Icon != null).Select(card => LoadIconAsync(card, stop));
            var guides = cards.SelectMany(c => c.Downloads).Where(r => r.Download.Guide != null).Select(row => LoadGuideAsync(row, stop));
            await Task.WhenAll(icons.Concat(guides));
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            // Never fault silently, and never let DisposeAsync rethrow.
            Logger.LogWarning(ex, "The Apps page could not read the apps image");
        }
    }

    /// <summary>One download's guide. Whatever goes wrong, that section ends as "Install guide unavailable", never a spinner.</summary>
    private async Task LoadGuideAsync(DownloadRow row, CancellationToken stop)
    {
        string? markdown;
        try
        {
            markdown = await CatalogClient.GetGuideAsync(row.Download.Guide!, stop);
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The install guide {Guide} could not be read", row.Download.Guide);
            markdown = null;
        }

        await InvokeAsync(() => row.SetGuide(markdown));
    }

    /// <summary>Checks the icon is there and a PNG before the browser is pointed at it; otherwise the neutral icon stays.</summary>
    private async Task LoadIconAsync(AppCard card, CancellationToken stop)
    {
        bool available;
        try
        {
            available = await CatalogClient.GetIconAsync(card.Entry.Icon!, stop) != null;
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The icon {Icon} could not be read", card.Entry.Icon);
            available = false;
        }

        await InvokeAsync(() => card.SetIcon(available));
    }

    private AppsPackageSnapshot Snapshot() => _package == null
        ? AppsPackageSnapshot.None
        : new AppsPackageSnapshot(true, _package.CurrentVersion != null, _package.IsUpdateInProgress);

    private void OnPackageChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            var snapshot = Snapshot();
            if (_catalog != null) _pageStatus = AppCard.DecidePage(_catalog, snapshot);
            foreach (var card in _cards) card.Apply(snapshot);
            StateHasChanged();
        });
    }

    private void OnProgressChanged()
    {
        if (ProgressIsOurs) _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>"Windows · x64", "Linux · arm64 · Kiosk devices". "any" architecture is left out.</summary>
    public static string DownloadTitle(AppDownload download)
    {
        var parts = new List<string> { PlatformName(download.Platform) };
        if (download.Architecture != AppArchitecture.Any) parts.Add(download.Architecture.ToString().ToLowerInvariant());
        if (download.Label != null) parts.Add(download.Label);
        return string.Join(" · ", parts);
    }

    private static string PlatformName(AppPlatform platform) => platform switch
    {
        AppPlatform.Windows => "Windows",
        AppPlatform.Linux => "Linux",
        AppPlatform.Macos => "macOS",
        AppPlatform.Android => "Android",
        AppPlatform.Ios => "iOS",
        _ => platform.ToString(),
    };

    // MudBlazor 8.9 has brand icons for Windows and Linux only; Apple platforms use the device icons.
    private static string PlatformIcon(AppPlatform platform) => platform switch
    {
        AppPlatform.Windows => Icons.Custom.Brands.MicrosoftWindows,
        AppPlatform.Linux => Icons.Custom.Brands.Linux,
        AppPlatform.Android => Icons.Material.Filled.Android,
        AppPlatform.Macos => Icons.Material.Filled.LaptopMac,
        AppPlatform.Ios => Icons.Material.Filled.PhoneIphone,
        _ => Icons.Material.Filled.Download,
    };

    private static string StatusText(AppStatus status) => status switch
    {
        AppStatus.Downloading => "Downloading",
        AppStatus.NotAvailableYet => "Not available yet",
        AppStatus.Ready => "Ready",
        _ => status.ToString(),
    };

    private static Color StatusColor(AppStatus status) => status switch
    {
        AppStatus.Ready => Color.Success,
        AppStatus.Downloading => Color.Info,
        _ => Color.Default,
    };

    public async ValueTask DisposeAsync()
    {
        if (_package != null) _package.PropertyChanged -= OnPackageChanged;
        Progress.Changed -= OnProgressChanged;

        await _stop.CancelAsync();
        if (_load != null) await _load;
        _stop.Dispose();
    }
}
